# SILAYUR — PostgreSQL (migrasi dari Turso/libSQL)
#
# Untuk Postgres lokal:
#   createdb silayur
#   createdb silayur_test

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/silayur

# Database terpisah untuk test (npm test). Opsional: fallback ke DATABASE_URL.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/silayur_test

# Required when seeding the initial Super Admin password.
DIGITAMA_SEED_ADMIN_PASSWORD=

# Optional: initialize the other demo accounts. Prefer unique passwords later.
# DIGITAMA_SEED_DEFAULT_PASSWORD=

# Used only by `npm run auth:set-password -- <username>`.
# DIGITAMA_NEW_PASSWORD=
