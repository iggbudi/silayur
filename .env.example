# SILAYUR — Turso / libSQL (Checkpoint 9)
#
# Local offline default used by scripts when this file is absent:
#   file:./.data/silayur.db
#
# For Turso Cloud, create a database then paste credentials:
#   turso db create silayur-dev
#   turso db show silayur-dev --url
#   turso db tokens create silayur-dev

TURSO_DATABASE_URL=file:./.data/silayur.db
# TURSO_DATABASE_URL=libsql://silayur-dev-YOURORG.turso.io
# TURSO_AUTH_TOKEN=

# Optional aliases (supported by db helpers)
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# Required when seeding the initial Super Admin password.
SILAYUR_SEED_ADMIN_PASSWORD=

# Optional: initialize the other demo accounts. Prefer unique passwords later.
# SILAYUR_SEED_DEFAULT_PASSWORD=

# Used only by `npm run auth:set-password -- <username>`.
# SILAYUR_NEW_PASSWORD=
