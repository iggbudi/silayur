[Unit]
Description=DIGITAMA Dashboard (Next.js/vinext production server)
After=network.target postgresql.service

[Service]
Type=simple
User=digitama
Group=digitama
WorkingDirectory=/opt/digitama
EnvironmentFile=/opt/digitama/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# Hindari downtime saat deploy manual & batasi akses
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
